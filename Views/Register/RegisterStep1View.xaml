<UserControl x:Class="LibraryManagementFE.Views.Register.RegisterStep1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>

        <!-- Email -->
        <TextBlock Text="Email"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFFFFF" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,4">
            <TextBox x:Name="TxtEmail"
                     Style="{StaticResource GlassTextBox}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Height="48" VerticalContentAlignment="Center"/>
            <TextBlock Text="ten.cua.ban@gm.uit.edu.vn"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowEmailPlaceholder, Converter={StaticResource BoolToVis}}"
                       Foreground="#66FFFFFF" FontSize="14"
                       FontFamily="{StaticResource InterFont}"
                       Margin="44,0,0,0" VerticalAlignment="Center"/>
            <!-- Envelope icon -->
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                     Margin="14,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                    <Path Data="M2 4h12c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2H2c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                    <Path Data="M16 6L8 11 0 6"
                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>
        </Grid>
        <TextBlock Text="{Binding EmailError}"
                   Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVis}}"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#FFADC8" Margin="2,0,0,0"/>

        <!-- Password -->
        <TextBlock Text="Mật khẩu (tối thiểu 8 ký tự)"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFFFFF" Margin="0,12,0,8"/>
        <Grid Margin="0,0,0,4">
            <PasswordBox x:Name="TxtPassword"
                         Style="{StaticResource GlassPasswordBox}"
                         Height="48" VerticalContentAlignment="Center"/>
            <TextBox x:Name="TxtPasswordVisible"
                     Style="{StaticResource GlassTextBox}"
                     Height="48" VerticalContentAlignment="Center"
                     Visibility="Collapsed"/>
            <!-- Lock icon -->
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                     Margin="14,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                    <Path Data="M11 5V4a3 3 0 0 0-6 0v1"
                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                    <Rectangle Canvas.Top="5" Width="16" Height="10"
                               RadiusX="2" RadiusY="2"
                               Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                </Canvas>
            </Viewbox>
            <Button x:Name="BtnTogglePassword"
                    Style="{StaticResource GlassIconButton}"
                    HorizontalAlignment="Right" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Click="BtnTogglePassword_Click"
                    ToolTip="Hiển thị mật khẩu">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="16" Height="16">
                        <Path Data="M1 8s3-5 7-5 7 5 7 5-3 5-7 5-7-5-7-5z"
                              Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4"
                                 Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
        <TextBlock Text="{Binding PasswordError}"
                   Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#FFADC8" Margin="2,0,0,0"/>

        <!-- Confirm Password -->
        <TextBlock Text="Xác nhận mật khẩu"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#FFFFFF" Margin="0,12,0,8"/>
        <Grid Margin="0,0,0,4">
            <PasswordBox x:Name="TxtConfirmPassword"
                         Style="{StaticResource GlassPasswordBox}"
                         Height="48" VerticalContentAlignment="Center"/>
            <TextBox x:Name="TxtConfirmPasswordVisible"
                     Style="{StaticResource GlassTextBox}"
                     Height="48" VerticalContentAlignment="Center"
                     Visibility="Collapsed"/>
            <!-- Lock icon -->
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                     Margin="14,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                    <Path Data="M11 5V4a3 3 0 0 0-6 0v1"
                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                    <Rectangle Canvas.Top="5" Width="16" Height="10"
                               RadiusX="2" RadiusY="2"
                               Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                </Canvas>
            </Viewbox>
            <Button x:Name="BtnToggleConfirmPassword"
                    Style="{StaticResource GlassIconButton}"
                    HorizontalAlignment="Right" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Click="BtnToggleConfirmPassword_Click"
                    ToolTip="Hiển thị mật khẩu">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="16" Height="16">
                        <Path Data="M1 8s3-5 7-5 7 5 7 5-3 5-7 5-7-5-7-5z"
                              Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4"
                                 Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
        <TextBlock Text="{Binding ConfirmPasswordError}"
                   Visibility="{Binding HasConfirmPasswordError, Converter={StaticResource BoolToVis}}"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#FFADC8" Margin="2,0,0,0"/>

    </StackPanel>
</UserControl>
