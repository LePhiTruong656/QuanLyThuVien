<UserControl x:Class="LibraryManagementFE.Views.Register.RegisterStep3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="200"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- Summary card -->
        <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
            <StackPanel>

                <!-- Email -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Email" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Email}" Style="{StaticResource SummaryValue}"/>
                </Grid>
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,10"/>

                <!-- Full name -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Họ và tên" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FullName}" Style="{StaticResource SummaryValue}"/>
                </Grid>
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,10"/>

                <!-- Loại thẻ -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Loại thẻ" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CardType}" Style="{StaticResource SummaryValue}"/>
                </Grid>
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,10"/>

                <!-- MSSV / Mã GV -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{Binding StudentIdLabel}" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StudentId}" Style="{StaticResource SummaryValue}"/>
                </Grid>
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,10"/>

                <!-- Ngày sinh -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Ngày sinh" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayDateOfBirth}" Style="{StaticResource SummaryValue}"/>
                </Grid>
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,0,0,10"/>

                <!-- Điện thoại -->
                <Grid>
                    <TextBlock Text="Điện thoại" Style="{StaticResource SummaryLabel}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayPhone}" Style="{StaticResource SummaryValue}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Agree to terms checkbox -->
        <CheckBox IsChecked="{Binding AgreeToTerms, Mode=TwoWay}"
                  Margin="0,0,0,0" Cursor="Hand">
            <TextBlock FontFamily="{StaticResource InterFont}"
                       FontSize="13" Foreground="#CCE2E8F0"
                       TextWrapping="Wrap">
                <Run Text="Tôi đồng ý với "/>
                <Run Text="nội quy thư viện UIT"
                     Foreground="#FFFFFF" FontWeight="SemiBold"
                     TextDecorations="Underline"/>
                <Run Text=" và các điều khoản sử dụng."/>
            </TextBlock>
        </CheckBox>

        <!-- Terms error -->
        <TextBlock Text="Vui lòng đồng ý với nội quy thư viện để tiếp tục."
                   Visibility="{Binding ShowTermsError, Converter={StaticResource BoolToVis}}"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#FFADC8" Margin="24,4,0,0"/>

    </StackPanel>
</UserControl>
