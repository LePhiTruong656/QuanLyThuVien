<Window x:Class="LibraryManagementFE.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Thư viện UIT"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandGradientBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             DECORATIVE ORBITAL BACKGROUND (left half)
        ═══════════════════════════════════════════ -->
        <Canvas Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                ClipToBounds="True" HorizontalAlignment="Left" Width="700">
            <!-- Outer faint ring -->
            <Ellipse Canvas.Left="-80" Canvas.Top="60"
                     Width="640" Height="640"
                     Stroke="#14FFFFFF" StrokeThickness="1" Fill="Transparent"/>
            <!-- Middle ring -->
            <Ellipse Canvas.Left="20" Canvas.Top="140"
                     Width="440" Height="440"
                     Stroke="#1AFFFFFF" StrokeThickness="1" Fill="Transparent"/>
            <!-- Inner glow sphere -->
            <Ellipse Canvas.Left="110" Canvas.Top="230"
                     Width="260" Height="260"
                     Fill="#0D1565C0" Stroke="#26FFFFFF" StrokeThickness="1"/>
            <!-- Orbital arc 1 (tilted ellipse simulation with thin ellipse + rotate) -->
            <Ellipse Canvas.Left="-30" Canvas.Top="200"
                     Width="600" Height="220"
                     Stroke="#1FFFFFFF" StrokeThickness="1" Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-20"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- Orbital arc 2 -->
            <Ellipse Canvas.Left="60" Canvas.Top="100"
                     Width="220" Height="600"
                     Stroke="#14FFFFFF" StrokeThickness="1" Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="15"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- Orbit dot 1 -->
            <Ellipse Canvas.Left="580" Canvas.Top="195" Width="12" Height="12"
                     Fill="#40FFFFFF"/>
            <!-- Orbit dot 2 -->
            <Ellipse Canvas.Left="80" Canvas.Top="108" Width="8" Height="8"
                     Fill="#33FFFFFF"/>
        </Canvas>

        <!-- ═══════════════════════════════════════════
             TOP BAR
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="48,0">
            <!-- Left: UIT branding -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Width="42" Height="42" CornerRadius="10"
                        Background="#26FFFFFF"
                        BorderBrush="#40FFFFFF" BorderThickness="1"
                        Margin="0,0,12,0">
                    <TextBlock Text="UIT"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="THƯ VIỆN UIT"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Library Management System"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="11"
                               Foreground="#99FFFFFF"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Register prompt -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Chưa có tài khoản?"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="14" Foreground="#CCE2E8F0"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource WhiteTextLink}" Content="Đăng ký"
                        Click="BtnRegister_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════
             MAIN CONTENT
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="48,0,48,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Hero Copy + Illustration ── -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,56,0">

                <!-- Sub-label -->
                <TextBlock Text="UIT LIBRARY  ·  HỆ THỐNG QUẢN LÝ"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#80FFFFFF"
                           Margin="0,0,0,24"/>

                <!-- Main tagline -->
                <TextBlock Text="Mở cửa"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="#FFFFFF"
                           LineHeight="62"/>
                <TextBlock Text="kho tri thức."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="#FFADC8"
                           LineHeight="62"
                           Margin="0,0,0,20"/>

                <!-- Description -->
                <TextBlock Text="{Binding StatsDescription}"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="15"
                           Foreground="#B3FFFFFF"
                           TextWrapping="Wrap"
                           MaxWidth="440"
                           LineHeight="24"
                           Margin="0,0,0,40"/>

                <!-- Book Illustration Card -->
                <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="20" Width="320" Height="180"
                        HorizontalAlignment="Left" Margin="0,0,0,44">
                    <Canvas>
                        <!-- Book stack: bottom (purple) -->
                        <Border Canvas.Left="94" Canvas.Top="118"
                                Width="128" Height="28" CornerRadius="4"
                                Background="#7C3AED">
                            <TextBlock Text="LITERATURE · I"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Middle (pink) -->
                        <Border Canvas.Left="88" Canvas.Top="88"
                                Width="128" Height="28" CornerRadius="4"
                                Background="#EC4899">
                            <TextBlock Text="HISTORY · VOL II"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Top (amber) -->
                        <Border Canvas.Left="82" Canvas.Top="52"
                                Width="128" Height="32" CornerRadius="4"
                                Background="#F59E0B">
                            <TextBlock Text="PHILOSOPHY"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Book spine accent lines -->
                        <Rectangle Canvas.Left="82" Canvas.Top="52"
                                   Width="5" Height="32" Fill="#E08900" RadiusX="2" RadiusY="2"/>
                        <Rectangle Canvas.Left="88" Canvas.Top="88"
                                   Width="5" Height="28" Fill="#C2185B" RadiusX="2" RadiusY="2"/>
                        <Rectangle Canvas.Left="94" Canvas.Top="118"
                                   Width="5" Height="28" Fill="#5B21B6" RadiusX="2" RadiusY="2"/>
                    </Canvas>
                </Border>

                <!-- Stats row -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="{Binding TotalBooks}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="ĐẦU SÁCH"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#66FFFFFF"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="{Binding TotalReaders}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="ĐỘC GIẢ"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#66FFFFFF"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding OnTimeRate}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="ĐÚNG HẠN"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#66FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── RIGHT: Glass Login Card ── -->
            <Border Grid.Column="1"
                    Background="#22FFFFFF"
                    BorderBrush="#44FFFFFF" BorderThickness="1"
                    CornerRadius="24"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,44">

                        <!-- Book icon -->
                        <Border Width="54" Height="54" CornerRadius="14"
                                Background="#33FFFFFF"
                                BorderBrush="#44FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Left" Margin="0,0,0,24">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"
                                          Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"
                                          Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Heading -->
                        <TextBlock Text="Đăng nhập"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Truy cập hệ thống quản lý thư viện UIT."
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="13"
                                   Foreground="#B3FFFFFF"
                                   Margin="0,0,0,28"/>

                        <!-- Email field -->
                        <TextBlock Text="Email"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <TextBox x:Name="TxtEmail" Style="{StaticResource GlassTextBox}"
                                     Height="48" VerticalContentAlignment="Center"/>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                                     Margin="14,0,0,0" IsHitTestVisible="False"
                                     VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M2 4h12c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2H2c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                    <Path Data="M16 6L8 11 0 6"
                                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- Password field -->
                        <TextBlock Text="Mật khẩu"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <PasswordBox x:Name="TxtPassword" Style="{StaticResource GlassPasswordBox}"
                                         Height="48" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource GlassTextBox}"
                                     Height="48" VerticalContentAlignment="Center"
                                     Visibility="Collapsed"/>
                            <!-- Lock icon -->
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left"
                                     Margin="14,0,0,0" IsHitTestVisible="False"
                                     VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M11 5V4a3 3 0 0 0-6 0v1"
                                          Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                    <Rectangle Canvas.Top="5" Width="16" Height="10"
                                               RadiusX="2" RadiusY="2"
                                               Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <!-- Eye toggle -->
                            <Button x:Name="BtnTogglePassword"
                                    Style="{StaticResource GlassIconButton}"
                                    HorizontalAlignment="Right" Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Click="BtnTogglePassword_Click"
                                    ToolTip="Hiển thị mật khẩu">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M1 8s3-5 7-5 7 5 7 5-3 5-7 5-7-5-7-5z"
                                              Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4"
                                                 Stroke="#99FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <!-- Remember me + Forgot password -->
                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkRememberMe" Content="Ghi nhớ tôi"
                                      FontFamily="{StaticResource InterFont}"
                                      FontSize="13" Foreground="#CCE2E8F0"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource WhiteTextLink}"
                                    Content="Quên mật khẩu?"
                                    Click="BtnForgotPassword_Click"/>
                        </Grid>

                        <!-- Login button -->
                        <Button Style="{StaticResource WhiteLoginButton}"
                                Content="Đăng nhập →"
                                Height="48"
                                Margin="0,0,0,28"
                                Click="BtnLogin_Click"/>

                        <!-- Divider -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#33FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="HOẶC"
                                       Margin="16,0"
                                       Foreground="#66FFFFFF"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#33FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Social buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource GlassSocialButton}"
                                    Grid.Column="0" Height="44"
                                    Click="BtnSocialLogin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G"
                                               FontFamily="{StaticResource InterFont}"
                                               FontWeight="Bold" FontSize="15"
                                               Foreground="#EA4335"
                                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Google"
                                               FontFamily="{StaticResource InterFont}"
                                               FontSize="13" Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GlassSocialButton}"
                                    Grid.Column="2" Height="44"
                                    Click="BtnSocialLogin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="f"
                                               FontFamily="{StaticResource InterFont}"
                                               FontWeight="Bold" FontSize="17"
                                               Foreground="#1877F2"
                                               Margin="-2,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Facebook"
                                               FontFamily="{StaticResource InterFont}"
                                               FontSize="13" Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             FOOTER
        ═══════════════════════════════════════════ -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 Trường Đại học Công nghệ Thông tin – ĐHQG-HCM"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#55FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
