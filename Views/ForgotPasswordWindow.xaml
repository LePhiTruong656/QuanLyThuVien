<Window x:Class="LibraryManagementFE.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu - Thư viện UIT"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Hero Section -->
            <ColumnDefinition Width="5*"/>
            <!-- Right Form Section -->
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════
             LEFT HERO SECTION (Glass effect + imagery)
        ════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource BrandGradientBrush}">
            <!-- Background Image Placeholder (Opacity) -->
            <Grid>
                <Border Background="#20000000"/>

                <!-- Content -->
                <StackPanel Margin="60,80,60,60">
                    <!-- Top Branding -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{StaticResource WhiteBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="UIT"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrandDeepBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="THƯ VIỆN UIT"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource WhiteBrush}"/>
                            <TextBlock Text="Library Management System"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="12"
                                       Foreground="#E2E8F0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tagline -->
                    <StackPanel Margin="0,100,0,80">
                        <TextBlock Text="Mở cửa"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="48" FontWeight="Bold"
                                   Foreground="{StaticResource WhiteBrush}"/>
                        <TextBlock Text="kho tri thức."
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="48" FontWeight="Bold"
                                   Foreground="{StaticResource Brand100Brush}"
                                   Margin="0,0,0,24"/>
                        <TextBlock Text="Quản lý hơn 12,000 đầu sách, theo dõi mượn trả, phục vụ 3,200+ độc giả trên một nền tảng duy nhất."
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource WhiteBrush}"
                                   Opacity="0.9"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   MaxWidth="450"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Stat Cards row -->
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="12.4K"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>
                                <TextBlock Text="Đầu sách"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource Brand200Brush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="3.2K"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>
                                <TextBlock Text="Độc giả"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource Brand200Brush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="98.5%"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"/>
                                <TextBlock Text="Đúng hạn"
                                           FontFamily="{StaticResource InterFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource Brand200Brush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════
             RIGHT FORM SECTION
        ════════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="{StaticResource WhiteBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
                    <StackPanel MaxWidth="400" Margin="40,80,40,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Heading -->
                        <TextBlock Text="Khôi phục mật khẩu"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Nhập email của bạn để nhận liên kết đặt lại mật khẩu."
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,40" TextWrapping="Wrap"/>

                        <!-- Form -->
                        
                        <!-- Email -->
                        <TextBlock Text="Email"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,32">
                            <TextBox x:Name="TxtEmail" Style="{StaticResource LoginTextBox}"
                                     Height="48" VerticalContentAlignment="Center" Padding="12,12,12,12"/>
                        </Grid>

                        <!-- Send Button -->
                        <Button Style="{StaticResource LoginButton}"
                                Content="Gửi liên kết"
                                Height="48"
                                Margin="0,0,0,32"
                                Click="BtnSendLink_Click"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Nhớ mật khẩu?"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource TextLink}" Content="Đăng nhập" Click="BtnLogin_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <TextBlock Grid.Row="1"
                           Text="© 2026 Trường Đại học Công nghệ Thông tin – ĐHQG-HCM"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="12" Foreground="{StaticResource TextDisabledBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>
            </Grid>
        </Border>
    </Grid>
</Window>
