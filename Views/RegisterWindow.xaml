<Window x:Class="LibraryManagementFE.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký - Thư viện UIT"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandGradientBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Slim thumb for the step-content scroll area -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="#40FFFFFF" CornerRadius="3" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             DECORATIVE ORBITAL BACKGROUND (left half)
        ═══════════════════════════════════════════ -->
        <Canvas Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                ClipToBounds="True" HorizontalAlignment="Left" Width="700">
            <Ellipse Canvas.Left="-80" Canvas.Top="60"
                     Width="640" Height="640"
                     Stroke="#14FFFFFF" StrokeThickness="1" Fill="Transparent"/>
            <Ellipse Canvas.Left="20" Canvas.Top="140"
                     Width="440" Height="440"
                     Stroke="#1AFFFFFF" StrokeThickness="1" Fill="Transparent"/>
            <Ellipse Canvas.Left="110" Canvas.Top="230"
                     Width="260" Height="260"
                     Fill="#0D1565C0" Stroke="#26FFFFFF" StrokeThickness="1"/>
            <Ellipse Canvas.Left="-30" Canvas.Top="200"
                     Width="600" Height="220"
                     Stroke="#1FFFFFFF" StrokeThickness="1" Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-20"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="60" Canvas.Top="100"
                     Width="220" Height="600"
                     Stroke="#14FFFFFF" StrokeThickness="1" Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="15"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="580" Canvas.Top="195" Width="12" Height="12" Fill="#40FFFFFF"/>
            <Ellipse Canvas.Left="80"  Canvas.Top="108" Width="8"  Height="8"  Fill="#33FFFFFF"/>
        </Canvas>

        <!-- ═══════════════════════════════════════════
             TOP BAR
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="48,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Width="42" Height="42" CornerRadius="10"
                        Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                        Margin="0,0,12,0">
                    <TextBlock Text="UIT"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="THƯ VIỆN UIT"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Library Management System"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="11" Foreground="#99FFFFFF"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Đã có tài khoản?"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="14" Foreground="#CCE2E8F0"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource WhiteTextLink}" Content="Đăng nhập"
                        Click="BtnLogin_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════
             MAIN CONTENT
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="48,0,48,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Hero Copy + Book Illustration ── -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,56,0">

                <TextBlock Text="THAM GIA UIT LIBRARY"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#80FFFFFF" Margin="0,0,0,24"/>

                <TextBlock Text="Bắt đầu hành trình"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="#FFFFFF" LineHeight="62"/>
                <TextBlock Text="đọc của bạn."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="#FFADC8" LineHeight="62"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Mở tài khoản chỉ 3 bước. Truy cập kho sách số 24/7 và quản lý hành trình đọc cá nhân."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="15" Foreground="#B3FFFFFF"
                           TextWrapping="Wrap" MaxWidth="440"
                           LineHeight="24" Margin="0,0,0,36"/>

                <!-- Book Stack Illustration -->
                <Canvas Width="360" Height="220" HorizontalAlignment="Left">
                    <Ellipse Canvas.Left="198" Canvas.Top="50" Width="150" Height="150"
                             Fill="#0D14B8A6" IsHitTestVisible="False"/>
                    <Border Canvas.Left="248" Canvas.Top="14" Width="96" Height="162" CornerRadius="16"
                            Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <StackPanel Margin="10,14">
                            <Rectangle Height="4" Fill="#4DFFFFFF" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left" Width="38" Margin="0,0,0,10"/>
                            <Rectangle Height="3" Fill="#33FFFFFF" RadiusX="1" RadiusY="1"
                                       HorizontalAlignment="Left" Width="74" Margin="0,0,0,7"/>
                            <Rectangle Height="3" Fill="#26FFFFFF" RadiusX="1" RadiusY="1"
                                       HorizontalAlignment="Left" Width="54" Margin="0,0,0,7"/>
                            <Rectangle Height="3" Fill="#26FFFFFF" RadiusX="1" RadiusY="1"
                                       HorizontalAlignment="Left" Width="66" Margin="0,0,0,7"/>
                            <Rectangle Height="3" Fill="#20FFFFFF" RadiusX="1" RadiusY="1"
                                       HorizontalAlignment="Left" Width="44" Margin="0,0,0,14"/>
                            <Rectangle Height="18" Fill="#33FFFFFF" RadiusX="9" RadiusY="9"
                                       HorizontalAlignment="Left" Width="52"/>
                        </StackPanel>
                    </Border>
                    <!-- Upper row -->
                    <Rectangle Canvas.Left="10"  Canvas.Top="20" Width="38" Height="120" Fill="#F97316" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="10"  Canvas.Top="20" Width="6"  Height="120" Fill="#EA6C0A" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="52"  Canvas.Top="35" Width="34" Height="105" Fill="#EC4899" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="52"  Canvas.Top="35" Width="6"  Height="105" Fill="#DB2777" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="90"  Canvas.Top="18" Width="40" Height="122" Fill="#84CC16" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="90"  Canvas.Top="18" Width="6"  Height="122" Fill="#65A30D" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="134" Canvas.Top="38" Width="36" Height="102" Fill="#F59E0B" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="134" Canvas.Top="38" Width="6"  Height="102" Fill="#D97706" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="174" Canvas.Top="22" Width="38" Height="118" Fill="#14B8A6" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="174" Canvas.Top="22" Width="6"  Height="118" Fill="#0D9488" RadiusX="3" RadiusY="0"/>
                    <!-- Lower row -->
                    <Rectangle Canvas.Left="28"  Canvas.Top="148" Width="36" Height="60" Fill="#F87171" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="28"  Canvas.Top="148" Width="6"  Height="60" Fill="#EF4444" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="68"  Canvas.Top="152" Width="38" Height="56" Fill="#FBBF24" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="68"  Canvas.Top="152" Width="6"  Height="56" Fill="#F59E0B" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="110" Canvas.Top="148" Width="34" Height="60" Fill="#A855F7" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="110" Canvas.Top="148" Width="6"  Height="60" Fill="#9333EA" RadiusX="3" RadiusY="0"/>
                    <Rectangle Canvas.Left="148" Canvas.Top="150" Width="36" Height="58" Fill="#38BDF8" RadiusX="3" RadiusY="3"/>
                    <Rectangle Canvas.Left="148" Canvas.Top="150" Width="6"  Height="58" Fill="#0EA5E9" RadiusX="3" RadiusY="0"/>
                </Canvas>

            </StackPanel>

            <!-- ── RIGHT: Glass Register Card ── -->
            <Border Grid.Column="1"
                    Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                    CornerRadius="24" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Card header -->
                        <RowDefinition Height="*"/>     <!-- Step content (scrollable) -->
                        <RowDefinition Height="Auto"/>  <!-- Navigation buttons -->
                    </Grid.RowDefinitions>

                    <!-- Card header: icon + title + step label + progress bar -->
                    <StackPanel Grid.Row="0" Margin="40,44,40,0">

                        <!-- User+ icon -->
                        <Border Width="54" Height="54" CornerRadius="14"
                                Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Left" Margin="0,0,0,24">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="5" Canvas.Top="2"
                                             Width="8" Height="8"
                                             Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Path Data="M1 20c0-4 3.6-7 8-7"
                                          Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Line X1="18" Y1="7"  X2="18" Y2="13"
                                          Stroke="#FFFFFF" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="15" Y1="10" X2="21" Y2="10"
                                          Stroke="#FFFFFF" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="{Binding CardTitle}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StepLabel}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="13" Foreground="#99FFFFFF"
                                   Margin="0,0,0,12"/>

                        <!-- Step progress bar -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="3" Fill="#FFFFFF" RadiusX="2" RadiusY="2"/>
                            <Rectangle Grid.Column="2" Height="3" Fill="#FFFFFF" RadiusX="2" RadiusY="2"
                                       Opacity="{Binding Step2Opacity}"/>
                            <Rectangle Grid.Column="4" Height="3" Fill="#FFFFFF" RadiusX="2" RadiusY="2"
                                       Opacity="{Binding Step3Opacity}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step content -->
                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource SlimScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="40,0,36,0">
                        <ContentControl x:Name="StepContent"/>
                    </ScrollViewer>

                    <!-- Navigation buttons -->
                    <Grid Grid.Row="2" Margin="40,16,40,40">
                        <Button Content="← Quay lại"
                                Style="{StaticResource WhiteTextLink}"
                                Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="BtnBack_Click"/>
                        <Button Content="{Binding ContinueLabel}"
                                Style="{StaticResource WhiteLoginButton}"
                                Height="48" MinWidth="180"
                                HorizontalAlignment="Right"
                                Click="BtnContinue_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             FOOTER
        ═══════════════════════════════════════════ -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 Trường Đại học Công nghệ Thông tin · ĐHQG-HCM"
                   FontFamily="{StaticResource InterFont}"
                   FontSize="12" Foreground="#55FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
